+// OpenCluely local-image extension (noncommercial personal use)
+function validInputContent(message: Record<string, unknown>): boolean {
+  if (typeof message.content === 'string') return true;
+  if (message.role !== 'user' || !Array.isArray(message.content) || message.content.length === 0) return false;
+  return message.content.every((part: unknown) => {
+    if (!isObject(part)) return false;
+    if (part.type === 'input_text') return typeof part.text === 'string' && part.text.length < 1000000;
+    if (part.type === 'input_image') return typeof part.image_url === 'string' && part.image_url.length < 15000000 &&
+      /^data:image\/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]+={0,2}$/.test(part.image_url);
+    return false;
+  });
+}
